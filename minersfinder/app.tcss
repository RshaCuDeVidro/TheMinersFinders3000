/* palette: pwnd.blog — neon fuchsia / purple / cyan / terminal green */
Screen { background: #050505; }

Header { background: #050505; color: #d946ef; text-style: bold; }
Footer { background: #050505; color: #6b7280; }

#status_bar { height: 1; background: #0a050f; color: #9ca3af; padding: 0 1; }

#header_area { height: 3; background: #050505; padding: 0 1; }
#filter_input {
    width: 1fr;
    border: solid #5b21b6;
    background: #050505;
    color: #e5e7eb;
}
#filter_input:focus { border: solid #d946ef; background: #0a0510; }
#filter_input > .input--placeholder { color: #9ca3af; }
#filter_input > .input--cursor { background: #d946ef; color: #050505; }

#view_tabs { height: 2; background: #050505; margin: 0 1; }
#view_tabs Tab { background: #050505; color: #6b7280; padding: 0 2; }
#view_tabs Tab.-active { color: #d946ef; background: #0a050f; text-style: bold; }
#view_tabs Tab:hover { color: #9333ea; }
#view_tabs .underline--bar { background: #3a1a5c; }
#view_tabs:focus .underline--bar { background: #d946ef; }

#main { layout: horizontal; height: 1fr; margin: 0 1 1 1; }

#left_pane { width: 58%; height: 1fr; border: solid #3a1a5c; margin-right: 1; }
#right_pane {
    width: 42%; height: 1fr; padding: 0 1;
    background: #0a050f; color: #d1d5db; border: solid #3a1a5c;
}
#left_pane:focus-within { border: solid #9333ea; }
#right_pane:focus-within { border: solid #9333ea; }

#main.narrow { layout: vertical; }
#main.narrow #left_pane { width: 100%; height: 3fr; margin-right: 0; }
#main.narrow #right_pane { width: 100%; height: 2fr; }

DataTable { height: 1fr; background: #050505; color: #9ca3af; }
DataTable > .datatable--header { background: #0a050f; color: #d946ef; text-style: bold; }
DataTable > .datatable--cursor { background: #9333ea; color: #ffffff; text-style: bold; }
DataTable > .datatable--hover { background: #14091f; }
DataTable > .datatable--odd-row { background: #08040e; }

Collapsible { background: #0a050f; border-top: solid #3a1a5c; padding: 0; }
CollapsibleTitle { color: #d946ef; background: #0a050f; }
Collapsible > Contents { padding: 0 1; }

HelpScreen { align: center middle; background: #000000 70%; }
#help {
    width: 84; height: auto; max-height: 90%;
    border: solid #9333ea; background: #0a050f; padding: 1 2;
}

SettingsScreen { align: center middle; background: #000000 70%; }
#settings { width: 68; height: auto; border: solid #9333ea; background: #0a050f; padding: 1 2; }
#settings_title { text-style: bold; color: #d946ef; }
#settings_sub { color: #6b7280; }
.set_row { height: 3; }
.set_row Static { width: 1fr; content-align: left middle; color: #9ca3af; }
.set_row Input { width: 18; }
#settings_buttons { height: 3; align: right middle; margin-top: 1; }
#settings_buttons Button { margin: 0 0 0 1; }

#page_bar { height: 1; background: #050505; padding: 0 1; }
#page_bar Button {
    min-width: 3; width: auto; height: 1;
    border: none; background: #14091f; color: #d946ef; text-style: bold;
    margin: 0 1 0 0; padding: 0 1;
}
#page_bar Button:hover { background: #9333ea; color: #ffffff; }
#page_bar Button:disabled { color: #4b2a6b; background: #0a050f; }
#page_label { width: auto; height: 1; content-align: center middle; color: #9ca3af; padding: 0 1; }
#page_spacer { width: 1fr; height: 1; }

ProgressBar { dock: bottom; margin: 0 1; height: 1; color: #d946ef; background: #1a0b26; }
